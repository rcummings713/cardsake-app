{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "digitalcardbox-app",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {},
  "env": {
    "dev": {
      "name": "digitalcardbox-app-dev",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "previews": {}
    },
    "test": {
      "name": "digitalcardbox-app-test",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "previews": {}
    },
    "prod": {
      "name": "digitalcardbox-app",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "previews": {}
    }
  }
}
